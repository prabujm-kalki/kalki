{
  "name": "kalki-bos",
  "private": true,
  "version": "0.1.0",
  "description": "Kalki Business Operating System",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently \"next dev -p 3001\" \"npm run cron\"",
    "tunnel": "npx ngrok http --domain=detached-manned-shining.ngrok-free.dev 3001",
    "cron": "tsx --env-file=.env src/workers/cron.ts",
    "db:sync-perms": "tsx --env-file=.env scripts/sync-permissions.ts",
    "build": "npm run db:sync-perms && next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/e2e/**",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:backup": "tsx --env-file=.env scripts/backup.ts",
    "db:restore": "tsx --env-file=.env scripts/restore.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@t3-oss/env-nextjs": "0.13.10",
    "@vladmandic/face-api": "^1.7.15",
    "better-auth": "1.7.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.3",
    "node-cron": "^4.6.0",
    "pg": "8.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "0.31.10",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.3",
    "ts-morph": "^28.0.0",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  },
  "overrides": {
    "drizzle-kit": {
      "@esbuild-kit/core-utils": {
        "esbuild": "^0.28.2"
      }
    }
  }
}
