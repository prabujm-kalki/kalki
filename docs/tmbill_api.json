  "item": [
    {
      "name": "lOGIN API",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var res = pm.response.json();\r",
              "if(pm.response.code===201){\r",
              "pm.environment.set('apiKey', res.access_token);\r",
              "pm.collectionVariables.set('apiKey', res.access_token);\r",
              "\r",
              "pm.environment.set('storeId', res.user.store_id);\r",
              "pm.collectionVariables.set('storeId', res.user.store_id);\r",
              "\r",
              "pm.environment.set('tmposId', res.user.tmpos_stores.tmpos_id);\r",
              "pm.collectionVariables.set('tmposId', res.user.tmpos_stores.tmpos_id);\r",
              "\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "apikey",
          "apikey": [
            {
              "key": "value",
              "value": "{{apiKey}}",
              "type": "string"
            },
            {
              "key": "key",
              "value": "tmbill-key",
              "type": "string"
            },
            {
              "key": "in",
              "value": "header",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\": \"{{username}}\",\r\n    \"password\": \"{{password}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://api.tmbill.com/tp/v1/store/login",
          "protocol": "https",
          "host": [
            "api",
            "tmbill",
            "com"
          ],
          "path": [
            "tp",
            "v1",
            "store",
            "login"
          ]
        }
      },
      "response": []
    },
